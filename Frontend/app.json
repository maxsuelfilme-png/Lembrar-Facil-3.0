
{
  "expo": {
    "name": "Lembra-Fácil",
    "slug": "mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/lembrafacil-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/lembrafacil-icon.png"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F5FFFA",
        "foregroundImage": "./assets/images/lembrafacil-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maxsueljds.lembrafacil",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FFFA",
          "image": "./assets/images/lembrafacil-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F5FFFA",
            "image": "./assets/images/lembrafacil-icon.png"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBpLOJUCKobJgMGZyO5bK76lJprO59Z4NY"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/lembrafacil-icon.png",
          "color": "#16A34A",
          "defaultChannel": "medicamentos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7541c6b-d908-432e-8fea-406f6e925f37"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d7541c6b-d908-432e-8fea-406f6e925f37"
    }
  }
}
