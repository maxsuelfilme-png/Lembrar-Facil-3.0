
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão para alarmes exatos -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Permissão para notificações -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Serviço em primeiro plano -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Reprodução de áudio em primeiro plano -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Tela de alarme sobre a tela de bloqueio -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Restaurar alarmes após reinicialização -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!-- Recebe os alarmes programados -->
        <receiver
            android:name="expo.modules.medicationalarm.MedicationAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Restaura alarmes após reinicialização -->
        <receiver
            android:name="expo.modules.medicationalarm.MedicationAlarmBootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

        <!-- Serviço responsável pela notificação e pelo som -->
        <service
            android:name="expo.modules.medicationalarm.MedicationAlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Tela do despertador -->
        <activity
            android:name="expo.modules.medicationalarm.MedicationAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

    </application>

</manifest>
