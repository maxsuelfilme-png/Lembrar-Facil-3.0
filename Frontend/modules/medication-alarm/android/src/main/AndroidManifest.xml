
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão para agendar alarmes exatos -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Permissão para mostrar notificações -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permissão para serviço em primeiro plano -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Permissão para reprodução de áudio -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Permissão para notificações em tela cheia -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Permissão para restaurar alarmes após reiniciar -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!-- Recebe o disparo dos alarmes -->
        <receiver
            android:name="expo.modules.medicationalarm.MedicationAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Restaura alarmes após reinicialização ou atualização -->
        <receiver
            android:name="expo.modules.medicationalarm.MedicationAlarmBootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

        </receiver>

        <!-- Serviço que toca o alarme e mostra a notificação -->
        <service
            android:name="expo.modules.medicationalarm.MedicationAlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Tela do despertador -->
        <activity
            android:name="expo.modules.medicationalarm.MedicationAlarmActivity"
            android:enabled="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

    </application>

</manifest>
